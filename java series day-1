public class Main {

    // Method to print a right triangle pattern
    static void printPattern(int rows) {
        for (int i = 1; i <= rows; i++) {
            for (int j = 1; j <= i; j++) {
                System.out.print("* ");
            }
            System.out.println();
        }
    }

    public static void main(String[] args) {

        System.out.println("===== Day 1: Java + DSA Challenge =====");
        System.out.println("Topic: Hello World & Pattern Printing\n");

        System.out.println("Hello, GitHub!");
        System.out.println("Welcome to my 30-Day Java + DSA Journey.\n");

        System.out.println("Pattern:\n");
        printPattern(5);
    }
}
