import java.util.ArrayDeque;
import java.util.Deque;

public class DequeExample {

    public static void main(String[] args) {

        Deque<Integer> deque = new ArrayDeque<>();

        deque.addFirst(20);
        deque.addFirst(10);

        deque.addLast(30);
        deque.addLast(40);

        System.out.println(deque);

        deque.removeFirst();
        deque.removeLast();

        System.out.println(deque);
    }
}